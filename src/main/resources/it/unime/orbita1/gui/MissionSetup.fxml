<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Slider?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="it.unime.orbita1.gui.MissionSetupController"
      spacing="20"
      alignment="CENTER">

 <Label text="Mission Setup"/>

    <Label text="Select Mission Duration:"/>
    <ChoiceBox fx:id="missionDurationChoiceBox"/>
    
    <Label text="Select Difficulty:"/>
    <ChoiceBox fx:id="difficultyChoiceBox"/>

    <Label text="Select Crew Size:"/>
    <Slider fx:id="crewSizeSlider"
            min="1"
            max="5"
            value="1"
            majorTickUnit="1"
            minorTickCount="0"
            snapToTicks="true"
            showTickMarks="true"
            showTickLabels="true"/>

    
    <Button fx:id="startMissionButton"
            text="Start Mission"
            onAction="#onStartMissionClicked"/>
    
    <Button fx:id="backButton"
            text="Back to Main Menu"
            onAction="#onBackClicked"/>
</VBox>
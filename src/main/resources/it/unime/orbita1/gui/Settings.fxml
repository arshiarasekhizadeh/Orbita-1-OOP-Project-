<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>

<VBox xmlns:fx="http://javafx.com/fxml" 
        prefWidth="1280"
        prefHeight="720"
        fx:controller="it.unime.orbita1.gui.SettingsController"
        spacing="20"
        alignment="CENTER">

    <Label text="Settings"/>
    
    <Label text="Configure your game settings here. You can adjust various parameters to customize your gaming experience. Make sure to save your changes before exiting."/>
    <TableView fx:id="keybindingsTable" prefWidth="600" prefHeight="400">
    <columns>
        <TableColumn fx:id="actionColumn" text="Action"/>
        <TableColumn fx:id="keyColumn" text="Key"/>
    </columns>
    </TableView>

    <Button fx:id="saveButton"
            text="Save Settings"
            onAction="#onSaveSettingsClicked"/>
    <Button fx:id="backButton"
            text="Back to Main Menu"
            onAction="#onBackClicked"/>
</VBox>